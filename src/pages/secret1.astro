---
// secret1 — where the modem takes you once you type the password.
// A fake Windows 98 / Web 1.0 desktop. A clock counts up in real time from
// 11:50:00 PM 12/31/1999; you have 10 real minutes to type the NEXT password
// ("password", placeholder) before midnight. At midnight, Y2K breaks the page:
// a Solitaire card cascade, melting images, and nonsensical error dialogs.
// Hidden test shortcut: Ctrl+Shift+M (or click the tiny corner) jumps to midnight.
//
// All behavior lives in the static same-origin file public/secret1.js so the
// strict CSP (script-src 'self') holds with no inline JS. Images are data: SVGs
// (allowed by img-src 'self' data:) so there are literal images to melt.
import Marquee from "../components/Marquee.astro";
const SITE_URL = "https://ohnoitsthenineties.lol";

// Build data: URIs at build time so we can author raw SVG and let
// encodeURIComponent make it CSP-safe.
const smilerSvg = `<svg xmlns='http://www.w3.org/2000/svg' width='96' height='96' viewBox='0 0 96 96'><circle cx='48' cy='48' r='44' fill='#ffe000' stroke='#000' stroke-width='4'/><circle cx='34' cy='40' r='6' fill='#000'/><circle cx='62' cy='40' r='6' fill='#000'/><path d='M28 60 Q48 82 68 60' fill='none' stroke='#000' stroke-width='6' stroke-linecap='round'/></svg>`;
const constructionSvg = `<svg xmlns='http://www.w3.org/2000/svg' width='260' height='60' viewBox='0 0 260 60'><rect width='260' height='60' fill='#ffcc00' stroke='#000' stroke-width='3'/><rect x='3' y='3' width='254' height='9' fill='#000'/><rect x='3' y='48' width='254' height='9' fill='#000'/><text x='130' y='39' font-family='monospace' font-size='17' font-weight='bold' text-anchor='middle' fill='#000'>UNDER CONSTRUCTION</text></svg>`;
const smiley = `data:image/svg+xml,${encodeURIComponent(smilerSvg)}`;
const construction = `data:image/svg+xml,${encodeURIComponent(constructionSvg)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${SITE_URL}/secret1/`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    <title>secret1</title>
  </head>
  <body>
    <Marquee />

    <div id="desktop">
      <div class="icons">
        <div class="icon" data-app="computer" role="button" tabindex="0"><span class="glyph">🖥️</span>My Computer</div>
        <div class="icon" data-app="recycle" role="button" tabindex="0"><span class="glyph">🗑️</span>Recycle Bin</div>
        <div class="icon" data-app="internet" role="button" tabindex="0"><span class="glyph">🌐</span>The Internet</div>
        <div class="icon" data-app="dnd" role="button" tabindex="0"><span class="glyph">🐉</span>DND Creator</div>
        <div class="icon" data-app="mines" role="button" tabindex="0"><span class="glyph">💣</span>Minesweeper</div>
        <div class="icon" data-app="kidpix" role="button" tabindex="0"><img class="icon__img" src="/kid-pix-icon.jpg" alt="" width="34" height="34" />KID PIX</div>
        <div class="icon" data-app="pajamasam" role="button" tabindex="0"><img class="icon__img" src="/pajama-sam-icon.jpg" alt="" width="34" height="34" />PAJAMA SAM</div>
      </div>

      <div class="windows">
        <!-- Y2K terminal: the clock + the next gate -->
        <section class="win win--main" id="mainwin">
          <div class="win__title">
            <span>⚠ Y2K COMPLIANCE TERMINAL</span>
            <span class="win__btns"><b>_</b><b>▢</b><b>✕</b></span>
          </div>
          <div class="win__body">
            <div class="lcd">
              <span id="clockTime">11:50:00 PM</span>
              <span id="clockDate">12 / 31 / 1999</span>
            </div>
            <p id="tminus" class="tminus">T–10:00 UNTIL Y2K</p>
            <p class="prompt">
              SYSTEM CLOCK ROLLOVER IMMINENT. Enter authorization code before
              midnight to avert catastrophic system failure:
            </p>
            <form id="gate" autocomplete="off" novalidate>
              <input
                id="pw"
                name="pw"
                type="password"
                inputmode="text"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                aria-label="Authorization code"
              />
              <button class="w95btn" type="submit">SUBMIT</button>
            </form>
            <p id="msg" class="msg" role="status" aria-live="polite"></p>
          </div>
        </section>

        <!-- Generic Web 1.0 flavor -->
        <section class="win win--decor" id="decorwin">
          <div class="win__title">
            <span>welcome.html — Netscape</span>
            <span class="win__btns"><b>_</b><b>▢</b><b>✕</b></span>
          </div>
          <div class="win__body decor">
            <img class="melt-target" src={smiley} width="72" height="72" alt="" />
            <p class="blink">*** WELCOME 2 MY HOMEPAGE ***</p>
            <img class="melt-target" src={construction} width="200" height="46" alt="under construction" />
            <p class="counter-line">
              You are visitor #<span id="counter">00001999</span>
            </p>
            <p class="rainbow gbook-link" role="button" tabindex="0">~ sign my guestbook! ~</p>
            <p class="small">Best viewed in Netscape Navigator 4.0 @ 800×600</p>
            <p class="webring">[ &lt; Prev ] &nbsp; [ Random ] &nbsp; [ Next &gt; ]</p>
          </div>
        </section>
      </div>
    </div>

    <div id="taskbar">
      <button class="start" type="button"><b>⊞</b> Start</button>
      <div class="tray"><span id="trayclock">11:50 PM</span></div>
    </div>

    <!-- Hidden test shortcut: jump straight to Y2K. Also Ctrl+Shift+M. -->
    <button id="skip" type="button" aria-hidden="true" tabindex="-1"></button>

    <style is:global>
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100%;
        background: #008080;
        overflow: hidden;
        font-family: "MS Sans Serif", Tahoma, Geneva, Verdana, sans-serif;
      }

      #desktop {
        position: fixed;
        inset: 34px 0 30px 0; /* below the marquee, above the taskbar */
        padding: 12px;
        overflow: hidden;
      }

      /* ---- desktop icons ---- */
      .icons {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 10; /* above the .windows container, which would else eat clicks */
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 76px; /* only the icon column is clickable, not the empty strip */
      }
      .icon {
        width: 76px;
        text-align: center;
        color: #fff;
        font-size: 12px;
        text-shadow: 1px 1px 2px #000;
        cursor: default;
        user-select: none;
      }
      .icon .glyph { display: block; font-size: 34px; margin-bottom: 4px; }
      .icon__img {
        display: block;
        width: 34px;
        height: 34px;
        margin: 0 auto 4px;
        object-fit: contain;
        image-rendering: pixelated;
      }

      /* ---- Win98 windows ---- */
      .windows {
        height: 100%;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        justify-content: center;
        gap: 26px;
        padding-left: 96px; /* clear the icon column */
      }
      .win {
        background: #c0c0c0;
        border: 2px solid;
        border-color: #dfdfdf #000 #000 #dfdfdf;
        box-shadow: inset -1px -1px #808080, inset 1px 1px #fff, 3px 3px 0 rgba(0,0,0,0.4);
        width: min(92vw, 420px);
      }
      .win__title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding: 3px 4px;
        background: linear-gradient(90deg, #000080, #1084d0);
        color: #fff;
        font-weight: bold;
        font-size: 13px;
        letter-spacing: 0.02em;
      }
      .win__btns { display: flex; gap: 3px; }
      .win__btns b {
        display: inline-grid;
        place-items: center;
        width: 17px;
        height: 15px;
        background: #c0c0c0;
        color: #000;
        border: 1px solid;
        border-color: #fff #000 #000 #fff;
        font: 10px/1 monospace;
      }
      .win__body { padding: 14px; }

      /* ---- the LCD clock ---- */
      .lcd {
        background: #000;
        border: 2px solid;
        border-color: #000 #808080 #808080 #000;
        padding: 10px 12px;
        text-align: center;
        color: #33ff66;
        font: bold 30px/1.1 ui-monospace, "Cascadia Code", Consolas, monospace;
        text-shadow: 0 0 8px currentColor;
        letter-spacing: 0.06em;
      }
      .lcd #clockDate {
        display: block;
        font-size: 15px;
        margin-top: 6px;
        color: #ffcc33;
      }
      .tminus {
        text-align: center;
        margin: 10px 0 0;
        font: bold 15px/1 ui-monospace, Consolas, monospace;
        letter-spacing: 0.12em;
        color: #b00000;
      }
      .tminus.fail {
        color: #fff;
        background: #b00000;
        padding: 6px;
        animation: fail-blink 0.4s steps(2, start) infinite;
      }
      @keyframes fail-blink { 50% { opacity: 0.35; } }
      .tminus.ok { color: #008000; }

      .prompt {
        font-size: 12px;
        line-height: 1.45;
        color: #000;
        margin: 12px 0;
      }
      #gate { display: flex; gap: 8px; }
      #pw {
        flex: 1;
        padding: 5px 7px;
        font: 14px/1.2 ui-monospace, Consolas, monospace;
        letter-spacing: 0.2em;
        color: #000;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        outline: none;
      }
      .w95btn {
        padding: 4px 12px;
        font-size: 12px;
        font-weight: bold;
        color: #000;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #000 #000 #fff;
        cursor: pointer;
      }
      .w95btn:active { border-color: #000 #fff #fff #000; }
      .msg {
        min-height: 1.2em;
        margin: 12px 0 0;
        font: bold 12px/1.4 ui-monospace, Consolas, monospace;
        color: #008000;
      }
      .msg.bad { color: #b00000; }
      @keyframes pw-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-5px); }
        40% { transform: translateX(5px); }
        60% { transform: translateX(-4px); }
        80% { transform: translateX(4px); }
      }
      #pw.wrong {
        border-color: #ff5a5a #b00000 #b00000 #ff5a5a;
        box-shadow: 0 0 0 2px rgba(255, 80, 80, 0.35);
        animation: pw-shake 0.4s;
      }

      /* ---- Web 1.0 flavor ---- */
      .decor { text-align: center; }
      .decor img { display: block; margin: 0 auto 10px; }
      .decor p { margin: 8px 0; }
      .blink {
        font-weight: bold;
        color: #0000ff;
        animation: blink 1s steps(2, start) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }
      .counter-line { font-size: 13px; }
      #counter {
        font-family: ui-monospace, Consolas, monospace;
        background: #000;
        color: #33ff66;
        padding: 1px 4px;
      }
      .rainbow {
        font-weight: bold;
        font-size: 15px;
        background: linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .small { font-size: 11px; color: #333; }
      .webring { font-size: 12px; color: #000080; }

      /* ---- taskbar ---- */
      #taskbar {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 4px;
        background: #c0c0c0;
        border-top: 2px solid #fff;
        z-index: 20;
      }
      .start {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        font-weight: bold;
        font-size: 13px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #000 #000 #fff;
        cursor: pointer;
      }
      .start b { font-size: 15px; }
      .tray {
        padding: 3px 10px;
        font-size: 12px;
        border: 1px solid;
        border-color: #808080 #fff #fff #808080;
      }

      /* ---- hidden test shortcut ---- */
      #skip {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 16px;
        height: 16px;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: default;
        z-index: 30;
      }

      /* ================= Y2K BREAKDOWN ================= */

      /* melting images / windows */
      @keyframes melt {
        to {
          transform: scaleY(2.6) skewX(7deg) translateY(6%);
          filter: blur(1.2px) saturate(1.6) hue-rotate(20deg);
          opacity: 0.88;
        }
      }
      .melt {
        transform-origin: top center;
        animation: melt 4s ease-in forwards;
      }

      /* whole-desktop glitch flicker */
      @keyframes glitch {
        0%   { filter: none; }
        8%   { filter: invert(1) hue-rotate(90deg); }
        12%  { filter: none; }
        38%  { filter: hue-rotate(180deg) saturate(3); }
        44%  { filter: none; }
        70%  { filter: invert(1); }
        76%  { filter: none; }
        100% { filter: hue-rotate(360deg); }
      }
      .glitch { animation: glitch 2.2s steps(1, end) infinite; }

      /* Solitaire cascade */
      #cardlayer {
        position: fixed;
        inset: 0;
        z-index: 900;
        pointer-events: none;
      }
      .card {
        position: fixed;
        top: 0;
        left: 0;
        width: 46px;
        height: 64px;
        background: #fff;
        border: 1px solid #333;
        border-radius: 5px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.45);
        font: bold 13px/1 ui-monospace, Consolas, monospace;
        will-change: transform;
      }
      .card--trail { will-change: auto; box-shadow: none; }
      .card__c { position: absolute; }
      .card__c.tl { top: 3px; left: 4px; }
      .card__c.br { bottom: 3px; right: 4px; transform: rotate(180deg); }
      .card__s {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 26px;
      }

      /* nonsensical error dialogs */
      .dialog {
        position: fixed;
        z-index: 1000;
        width: 300px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #dfdfdf #000 #000 #dfdfdf;
        box-shadow: inset -1px -1px #808080, inset 1px 1px #fff, 3px 3px 0 rgba(0,0,0,0.5);
        font-size: 12px;
      }
      .dialog__title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 3px 5px;
        background: linear-gradient(90deg, #000080, #1084d0);
        color: #fff;
        font-weight: bold;
      }
      .dialog__x {
        display: inline-grid;
        place-items: center;
        width: 17px;
        height: 15px;
        background: #c0c0c0;
        color: #000;
        border: 1px solid;
        border-color: #fff #000 #000 #fff;
        cursor: pointer;
      }
      .dialog__body {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 16px 14px;
      }
      .dialog__icon { font-size: 30px; }
      .dialog__body p { margin: 0; line-height: 1.4; }
      .dialog__foot {
        display: flex;
        justify-content: center;
        gap: 10px;
        padding: 0 14px 14px;
      }

      /* ---- interactive icons ---- */
      .icon {
        padding: 4px 2px;
        border: 1px dotted transparent;
        cursor: pointer;
        outline: none;
      }
      .icon:hover .glyph { filter: brightness(1.2) drop-shadow(0 0 4px #fff); }
      .icon.sel,
      .icon:focus {
        background: rgba(0, 0, 128, 0.45);
        border: 1px dotted #fff;
      }

      /* ---- opened application windows ---- */
      #apps {
        position: fixed;
        inset: 0;
        z-index: 500;
        pointer-events: none;
      }
      #apps .appwin { pointer-events: auto; }
      .appwin {
        position: fixed;
        width: 300px;
        transform-origin: top center;
      }
      .win__title span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .win__close { cursor: pointer; }

      /* My Computer / Control Panel drive rows */
      .drive {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 2px;
        font-size: 13px;
      }
      .drive > span { font-size: 26px; }
      .drive small { color: #333; }

      /* Image popups (KID PIX, PAJAMA SAM) */
      .imgpopup { text-align: center; }
      .imgpopup__img {
        display: block;
        width: 100%;
        height: auto;
        margin: 0 0 10px;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        image-rendering: pixelated;
      }
      .imgpopup__cap { margin: 0 0 8px; font-weight: bold; }

      /* The Internet (Netscape) — address bar + page */
      .bnav { display: flex; align-items: center; gap: 4px; margin-bottom: 8px; }
      .bnav__btn {
        padding: 3px 7px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #000 #000 #fff;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
      }
      .bnav__btn:active { border-color: #000 #fff #fff #000; }
      .bnav__url {
        flex: 1;
        min-width: 0;
        padding: 4px 6px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        font: 12px/1 ui-monospace, Consolas, monospace;
      }
      .browser__page { text-align: center; max-height: 320px; overflow: auto; }
      .weblink { color: #0000ee; font-weight: bold; text-decoration: underline; cursor: pointer; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .throbber { font-size: 34px; display: inline-block; animation: spin 1.2s linear infinite; }

      /* eBay-style shop */
      .ebay { text-align: left; }
      .ebay__head {
        margin-bottom: 8px;
        padding: 4px 6px;
        background: linear-gradient(90deg, #ffe000, #ff8c00);
        border: 1px solid #000;
        font-size: 12px;
        font-weight: bold;
        text-align: center;
      }
      .ebay__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
      .listing {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        padding: 6px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        text-align: center;
      }
      .listing__img {
        width: 100%;
        aspect-ratio: 1 / 1;
        display: grid;
        place-items: center;
        font-size: 34px;
        border: 1px solid #999;
      }
      .listing__img.green { background: #38b24a; }
      .listing__img.red { background: #e23b3b; }
      .listing__img.yellow { background: #f3d43b; }
      .listing__title { font-size: 11px; font-weight: bold; line-height: 1.2; }
      .listing__stars { color: #f39c00; font-size: 11px; }
      .listing__price { color: #008000; font-weight: bold; font-size: 14px; }
      .listing__bids { font-size: 10px; color: #555; }
      .listing__buy { margin-top: 2px; padding: 3px 6px; font-size: 10px; }

      /* "You saved the millennium" prize banner */
      .prize {
        position: fixed;
        inset: 0;
        z-index: 1600;
        display: grid;
        place-items: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.5);
      }
      .prize__box {
        position: relative;
        width: 100%;
        max-width: 420px;
        padding: 26px 22px;
        text-align: center;
        background: #000;
        border: 4px solid;
        border-image: linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f) 1;
        box-shadow: 0 0 40px rgba(255, 255, 255, 0.35);
      }
      .prize__x {
        position: absolute;
        top: 6px;
        right: 8px;
        background: none;
        border: 0;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
      }
      .prize__hd {
        margin: 0 0 16px;
        font: bold 20px/1.4 ui-monospace, "Cascadia Code", Consolas, monospace;
        color: #fff;
        text-shadow: 0 0 8px #fff;
        animation: blink 0.8s steps(2, start) infinite;
      }
      @keyframes prize-pulse { 50% { transform: scale(1.08); } }
      .prize__claim {
        padding: 10px 22px;
        background: linear-gradient(#ffe98a, #d4a300);
        border: 3px outset #ffd700;
        font: bold 15px ui-monospace, Consolas, monospace;
        color: #4a2c00;
        cursor: pointer;
        animation: prize-pulse 0.9s ease-in-out infinite;
      }
      .prize__reveal {
        margin: 16px 0 0;
        font: bold 26px/1.3 ui-monospace, "Cascadia Code", Consolas, monospace;
        letter-spacing: 2px;
        background: linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* Guestbook */
      .gbook-link { cursor: pointer; }
      .gbook__title { margin: 0 0 8px; text-align: center; font-weight: bold; color: #0000cc; }
      .gbook__list {
        max-height: 200px;
        overflow: auto;
        margin-bottom: 8px;
        padding: 6px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
      }
      .gbook__entry { padding: 5px 4px; border-bottom: 1px dashed #bbb; }
      .gbook__entry:last-child { border-bottom: 0; }
      .gbook__meta { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; }
      .gbook__meta b { color: #a000a0; }
      .gbook__meta span { color: #888; }
      .gbook__body { margin-top: 2px; font-size: 12px; line-height: 1.35; word-break: break-word; }
      .gbook__form { display: flex; flex-direction: column; gap: 6px; }
      .gbook__name, .gbook__in {
        padding: 5px 6px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        font: 12px ui-monospace, Consolas, monospace;
      }
      .gbook__in { min-height: 46px; resize: vertical; }
      .gbook__form .w95btn { align-self: flex-end; }

      /* D&D Character Creator */
      .dnd { font-size: 12px; }
      .dnd__hd {
        margin: -14px -14px 10px;
        padding: 6px;
        background: linear-gradient(90deg, #4b1d6f, #7a2ea8);
        color: #ffd700;
        font-weight: bold;
        text-align: center;
        letter-spacing: 0.5px;
      }
      .dnd__row { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
      .dnd__row label { width: 42px; font-weight: bold; }
      .dnd__name {
        flex: 1;
        min-width: 0;
        padding: 4px 6px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        font: 12px ui-monospace, Consolas, monospace;
      }
      .dnd__row select { flex: 1; min-width: 0; padding: 3px; font-size: 12px; }
      .dnd__portrait {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 8px 0;
        padding: 8px 12px;
        background: #fff;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
      }
      .dnd__emoji { font-size: 40px; line-height: 1; }
      .dnd__hp { font: bold 13px ui-monospace, Consolas, monospace; }
      .dnd__hp b { color: #b00000; font-size: 17px; }
      .dnd__abils { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-bottom: 8px; }
      .abil {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4px 2px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #fff #808080 #808080 #fff;
      }
      .abil__name { font-size: 10px; font-weight: bold; color: #333; }
      .abil__score { font: bold 18px ui-monospace, Consolas, monospace; }
      .abil__mod { font-size: 11px; color: #006000; }
      .dnd__ctrls { display: flex; gap: 6px; }
      .dnd__ctrls .w95btn { flex: 1; padding: 6px 4px; font-size: 11px; }
      .dnd__flavor { margin: 10px 0 0; min-height: 1em; font-size: 11px; font-style: italic; color: #333; }
      .dnd__secret {
        margin: 10px 0 0;
        padding: 8px;
        border: 1px dashed #7a2ea8;
        background: #f3e9fb;
        font-size: 11px;
        font-style: italic;
        color: #4b1d6f;
      }

      /* Run / Shut Down */
      .runrow { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
      .runinput {
        flex: 1;
        padding: 4px 6px;
        border: 2px solid;
        border-color: #808080 #fff #fff #808080;
        font: 13px ui-monospace, Consolas, monospace;
      }
      .runfoot { display: flex; justify-content: flex-end; gap: 6px; margin-top: 12px; }
      .sdopts { margin: 10px 0; line-height: 1.7; }

      /* ---- Start menu ---- */
      .start.active { border-color: #000 #fff #fff #000; }
      .startmenu {
        position: fixed;
        left: 2px;
        bottom: 32px;
        z-index: 1100;
        display: flex;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #dfdfdf #000 #000 #dfdfdf;
        box-shadow: inset -1px -1px #808080, inset 1px 1px #fff, 3px 3px 0 rgba(0,0,0,0.5);
      }
      .startmenu__side {
        width: 28px;
        background: linear-gradient(#1084d0, #000080);
        color: #fff;
        font-weight: bold;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        text-align: left;
        padding: 12px 5px;
        letter-spacing: 0.08em;
      }
      .startmenu__items { display: flex; flex-direction: column; padding: 2px; min-width: 190px; }
      .startmenu__item {
        text-align: left;
        padding: 7px 22px 7px 10px;
        background: transparent;
        border: 0;
        font-size: 13px;
        color: #000;
        cursor: pointer;
      }
      .startmenu__item:hover { background: #000080; color: #fff; }
      .startmenu__items hr {
        height: 0;
        margin: 3px 2px;
        border: 0;
        border-top: 1px solid #808080;
        border-bottom: 1px solid #fff;
      }

      /* ---- "safe to turn off" shutdown screen ---- */
      .shutdown {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: grid;
        place-items: center;
        text-align: center;
        background: #000;
        color: #ffb000;
        font: bold 26px/1.5 ui-monospace, Consolas, monospace;
        text-shadow: 0 0 14px #ffb000;
        cursor: pointer;
      }
      .shutdown .small { margin-top: 22px; font-size: 13px; color: #8a6000; }

      /* ================= Minesweeper app (scoped under .mines) ================= */
      .mines {
        position: relative;
        --face: #c0c0c0;
        --hi: #fff;
        --lo: #808080;
        --lo2: #404040;
        --lcd-bg: #000;
        --lcd-fg: #ff2b2b;
        --gold: #d4a300;
        font-family: Tahoma, "Segoe UI", Verdana, Arial, sans-serif;
        color: #000;
      }
      .mines, .mines * { user-select: none; }
      .mines .ms-prompt {
        margin: 0 0 10px;
        font-size: 12px;
        line-height: 1.45;
        color: #1a1a1a;
      }
      .mines .panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
        padding: 6px;
        border: 2px solid;
        border-color: var(--lo2) var(--hi) var(--hi) var(--lo2);
      }
      .mines .lcd {
        min-width: 56px;
        padding: 2px 6px;
        background: var(--lcd-bg);
        color: var(--lcd-fg);
        font: bold 22px/1.2 "Courier New", monospace;
        letter-spacing: 2px;
        text-align: center;
        border: 1px solid;
        border-color: var(--lo2) var(--hi) var(--hi) var(--lo2);
        text-shadow: none;
      }
      .mines .smiley {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
        background: var(--face);
        border: 2px solid;
        border-color: var(--hi) var(--lo2) var(--lo2) var(--hi);
        cursor: pointer;
      }
      .mines .smiley:active { border-color: var(--lo2) var(--hi) var(--hi) var(--lo2); }
      .mines .board-frame {
        padding: 6px;
        border: 2px solid;
        border-color: var(--lo2) var(--hi) var(--hi) var(--lo2);
      }
      .mines .grid {
        display: grid;
        grid-template-columns: repeat(9, 1fr);
        gap: 0;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: var(--lo2);
      }
      .mines .cell {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--face);
        font-weight: bold;
        font-size: clamp(11px, 3.2vw, 16px);
        cursor: pointer;
      }
      .mines .cell.hidden { border: 2px solid; border-color: var(--hi) var(--lo2) var(--lo2) var(--hi); }
      .mines .cell.revealed { border: 1px solid #999; background: #c8c8c8; cursor: default; }
      .mines .cell.mine-hit { background: #ff4d4d; }
      .mines .cell.n1 { color: #0000ff; } .mines .cell.n2 { color: #008000; }
      .mines .cell.n3 { color: #ff0000; } .mines .cell.n4 { color: #000080; }
      .mines .cell.n5 { color: #800000; } .mines .cell.n6 { color: #008080; }
      .mines .cell.n7 { color: #000; }    .mines .cell.n8 { color: #808080; }
      .mines .cell.revealed.star { background: #f4dd8a; }
      .mines .badge {
        position: absolute;
        top: 1px;
        left: 1px;
        width: 12px;
        height: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--gold);
        color: #000;
        font-size: 8px;
        font-weight: bold;
        line-height: 1;
        box-shadow: 0 0 0 1px #7a5c00;
      }
      .mines .controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 8px;
      }
      .mines .flagmode {
        padding: 6px 10px;
        background: var(--face);
        border: 2px solid;
        border-color: var(--hi) var(--lo2) var(--lo2) var(--hi);
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
      }
      .mines .flagmode.active {
        background: #e8d27a;
        border-color: var(--lo2) var(--hi) var(--hi) var(--lo2);
      }
      .mines .hint-toggle {
        padding: 6px 4px;
        background: none;
        border: 0;
        color: #003c8f;
        font-size: 11px;
        text-decoration: underline;
        cursor: pointer;
      }
      .mines .code-panel {
        margin-top: 12px;
        padding: 10px 12px;
        background: var(--face);
        border: 2px solid;
        border-color: var(--hi) var(--lo2) var(--lo2) var(--hi);
      }
      .mines .code-panel h2 { margin: 0 0 8px; font-size: 12px; letter-spacing: 0.5px; }
      .mines .code-slots { display: flex; gap: 6px; }
      .mines .slot {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--lcd-bg);
        color: var(--lcd-fg);
        font: bold 20px "Courier New", monospace;
        border: 1px solid;
        border-color: var(--lo2) var(--hi) var(--hi) var(--lo2);
      }
      /* in-window modals */
      .mines .overlay {
        position: absolute;
        inset: 0;
        z-index: 50;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(0, 32, 32, 0.55);
      }
      .mines .overlay.show { display: flex; }
      .mines .overlay-box {
        width: 100%;
        max-width: 320px;
        background: var(--face);
        border: 2px solid;
        border-color: var(--hi) var(--lo2) var(--lo2) var(--hi);
      }
      .mines .ov-title {
        padding: 4px 6px;
        background: linear-gradient(90deg, #000080, #1084d0);
        color: #fff;
        font-weight: bold;
        font-size: 13px;
      }
      .mines .overlay-body { padding: 16px; text-align: center; }
      .mines .overlay-body .big { margin: 2px 0 10px; font-size: 26px; }
      .mines .overlay-body p { margin: 8px 0; font-size: 12.5px; line-height: 1.5; }
      .mines .code-out {
        margin: 10px 0;
        padding: 8px;
        background: var(--lcd-bg);
        color: var(--lcd-fg);
        font: bold 26px "Courier New", monospace;
        letter-spacing: 6px;
      }
      .mines .overlay-btn {
        margin-top: 10px;
        padding: 7px 18px;
        background: var(--face);
        border: 2px solid;
        border-color: var(--hi) var(--lo2) var(--lo2) var(--hi);
        font-size: 12.5px;
        font-weight: bold;
        cursor: pointer;
      }

      @media (prefers-reduced-motion: reduce) {
        .blink, .tminus.fail, .glitch, .throbber,
        .prize__hd, .prize__claim, #pw.wrong { animation: none; }
        .melt { animation-duration: 0.01s; }
      }
    </style>

